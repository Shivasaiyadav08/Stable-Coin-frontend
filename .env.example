# Optional for browser extension wallets; required for WalletConnect / QR connections.
# Create a project at https://cloud.walletconnect.com and copy its project ID here.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional dedicated Sepolia RPC URL. The public chain RPC is used when empty.
# NEXT_PUBLIC values are visible in the browser; use domain-restricted public keys.
NEXT_PUBLIC_SEPOLIA_RPC_URL=
